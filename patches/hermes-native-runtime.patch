+def native_context_breakdown(agent: Any) -> Optional[dict[str, Any]]:
+    """The breakdown for a native-runtime chat, from the CLI's own reading: Hermes's prompt, tools and
+    transcript are not what the CLI sends, so estimating them would describe a context that does not
+    exist. None until the CLI has reported once."""
+    from agent.native_runtime import native_context
+    ctx = native_context(agent, refresh=True)
