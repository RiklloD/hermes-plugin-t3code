+def native_context_breakdown(agent: Any) -> Optional[dict[str, Any]]:
+    """The breakdown for a native-runtime chat, from the CLI's own reading: Hermes's prompt, tools and
+    transcript are not what the CLI sends, so estimating them would describe a context that does not
+    exist. None until the CLI has reported once."""
+    from agent.native_runtime import native_context
+    ctx = native_context(agent, refresh=True)
+    context_max = int(ctx.get("context_max") or 0)
+    if not context_max:
+        return None
+    categories = []
+    for row in ctx.get("categories") or []:
+        category_id, tokens = str(row.get("id") or ""), int(row.get("tokens") or 0)
+        if not category_id or tokens <= 0:
+            continue
+        known = category_id in _CATEGORIES
+        categories.append({"id": category_id, "tokens": tokens,
+                           "label": _category_label(category_id) if known else str(row.get("label") or category_id),
+                           "color": (_CATEGORIES[category_id] if known else _CATEGORIES["system_prompt"])[0]})
+    context_used = min(int(ctx.get("context_used") or 0), context_max)
+    return {
+        "categories": categories,
+        "context_max": context_max,
+        "context_percent": max(0, min(100, round(context_used / context_max * 100))),
+        "context_used": context_used,
+        "context_source": "provider_usage",
+        "context_estimated": False,
+        "estimated_total": sum(c["tokens"] for c in categories),
+        "model": str(ctx.get("model") or getattr(agent, "model", "") or ""),
+    }
