+    if not context_max:
+        return None
+    categories = []
+    for row in ctx.get("categories") or []:
+        category_id, tokens = str(row.get("id") or ""), int(row.get("tokens") or 0)
+        if not category_id or tokens <= 0:
+            continue
+        known = category_id in _CATEGORIES
